    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter JWT token"
      }
    },
    "schemas": {
      "UpdateUserProfileDto": { "type": "object", "properties": {} },
      "CreateMediaItemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type of media",
            "enum": ["IMAGE", "VIDEO", "AUDIO"],
            "example": "IMAGE"
          },
          "key": {
            "type": "string",
            "description": "S3 key returned from upload-intent",
            "example": "soma/user-id/1744444800000-f3a9c1b2e4d50f87.jpg"
          }
        },
        "required": ["type", "key"]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the post",
            "example": "The Future of AI in 2025"
          },
          "body": {
            "type": "string",
            "description": "Body/content of the post",
            "example": "Here are my thoughts on AI developments..."
          },
          "somaId": {
            "type": "string",
            "description": "UUID of the soma where the post will be created",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "media": {
            "description": "Media items to attach — each key comes from upload-intent",
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateMediaItemDto" }
          }
        },
        "required": ["title", "somaId"]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "title": { "type": "string", "example": "The Future of AI in 2025" },
          "body": {
            "type": "object",
            "example": "Here are my thoughts on AI developments...",
            "nullable": true
          },
          "authorId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174001"
          },
          "somaId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174002"
          },
          "impressions": {
            "type": "number",
            "example": 0,
            "description": "Number of times the post has been viewed"
          },
          "createdAt": { "format": "date-time", "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" }
        },
        "required": [
          "id",
          "title",
          "body",
          "authorId",
          "somaId",
          "impressions",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Updated title of the post",
            "example": "The Future of AI in 2025 - Updated"
          },
          "body": {
            "type": "string",
            "description": "Updated body/content of the post",
            "example": "Here are my updated thoughts..."
          }
        }
      },
      "CreateSomaDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the soma",
            "example": "Technology News"
          },
          "slug": {
            "type": "string",
            "description": "URL-safe slug for the soma (lowercase, alphanumeric and hyphens only)",
            "example": "tech-news"
          },
          "description": {
            "type": "string",
            "description": "Description of the soma",
            "example": "A community for discussing the latest in technology"
          }
        },
        "required": ["name", "slug"]
      },
      "Soma": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "slug": { "type": "string", "example": "tech-news" },
          "name": { "type": "string", "example": "Technology News" },
          "description": {
            "type": "object",
            "example": "A community for discussing the latest in technology",
            "nullable": true
          },
          "createdAt": { "format": "date-time", "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" }
        },
        "required": [
          "id",
          "slug",
          "name",
          "description",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "The content of the comment",
            "example": "This is a great post!"
          }
        },
        "required": ["content"]
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Comment UUID" },
          "content": {
            "type": "string",
            "description": "Content of the comment"
          },
          "authorId": { "type": "string", "description": "Author UUID" },
          "postId": { "type": "string", "description": "Post UUID" },
          "parentCommentId": {
            "type": "object",
            "description": "Parent Comment UUID",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Last update timestamp"
          }
        },
        "required": [
          "id",
          "content",
          "authorId",
          "postId",
          "parentCommentId",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateCommentDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "The content of the comment",
            "example": "This is a great post!"
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Notification UUID" },
          "userId": { "type": "string", "description": "Recipient User UUID" },
          "type": {
            "type": "string",
            "description": "Notification type (e.g. COMMENT, AWARD)"
          },
          "message": {
            "type": "string",
            "description": "Notification message"
          },
          "targetType": {
            "type": "object",
            "description": "Target type (e.g. POST, COMMENT)",
            "nullable": true
          },
          "targetId": {
            "type": "object",
            "description": "Target UUID",
            "nullable": true
          },
          "readAt": {
            "type": "object",
            "description": "Read timestamp",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp"
          }
        },
        "required": [
          "id",
          "userId",
          "type",
          "message",
          "targetType",
          "targetId",
          "readAt",
          "createdAt"
        ]
      },
      "CreateVoteDto": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string",
            "description": "The type of the target being voted on",
            "enum": ["POST", "COMMENT"],
            "example": "POST"
          },
          "targetId": {
            "type": "string",
            "description": "The UUID of the target being voted on",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "value": {
            "type": "number",
            "description": "The value of the vote: +1 (upvote) or -1 (downvote)",
            "example": 1,
            "enum": [1, -1]
          }
        },
        "required": ["targetType", "targetId", "value"]
      },
      "Vote": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Vote UUID" },
          "userId": {
            "type": "string",
            "description": "User UUID who cast the vote"
          },
          "targetType": {
            "type": "string",
            "description": "Target type",
            "enum": ["POST", "COMMENT"]
          },
          "targetId": { "type": "string", "description": "Target UUID" },
          "value": { "type": "number", "description": "Vote value (+1 or -1)" },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp"
          }
        },
        "required": [
          "id",
          "userId",
          "targetType",
          "targetId",
          "value",
          "createdAt"
        ]
      },
      "DeleteVoteDto": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string",
            "description": "The type of the target being un-voted",
            "enum": ["POST", "COMMENT"],
            "example": "POST"
          },
          "targetId": {
            "type": "string",
            "description": "The UUID of the target being un-voted",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        },
        "required": ["targetType", "targetId"]
      },
      "UploadIntentDto": {
        "type": "object",
        "properties": {
          "mediaType": {
            "type": "string",
            "description": "Type of media to upload",
            "enum": ["IMAGE", "VIDEO", "AUDIO"],
            "example": "IMAGE"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the file",
            "example": "image/jpeg"
          },
          "fileName": {
            "type": "string",
            "description": "Name of the file",
            "example": "photo.jpg"
          }
        },
        "required": ["mediaType", "mimeType", "fileName"]
      },
      "UploadIntentResponseDto": {
        "type": "object",
        "properties": {
          "presignedUploadUrl": {
            "type": "string",
            "description": "Presigned URL for uploading the file",
            "example": "https://bucket.s3.region.amazonaws.com/..."
          },
          "finalPublicUrl": {
            "type": "string",
            "description": "Final public URL of the uploaded file",
            "example": "https://bucket.s3.region.amazonaws.com/soma/user-id/..."
          },
          "key": {
            "type": "string",
            "description": "S3 object key — pass this back when creating a post with media",
            "example": "soma/user-id/1744444800000-f3a9c1b2e4d50f87.jpg"
          }
        },
        "required": ["presignedUploadUrl", "finalPublicUrl", "key"]
      },
      "MediaItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "collectionId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174001"
          },
          "type": {
            "type": "string",
            "enum": ["IMAGE", "VIDEO", "AUDIO"],
            "example": "IMAGE"
          },
          "originalUrl": {
            "type": "string",
            "example": "https://bucket.s3.region.amazonaws.com/soma/user-id/..."
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "example": { "width": 1920, "height": 1080 }
          },
          "createdAt": { "format": "date-time", "type": "string" }
        },
        "required": [
          "id",
          "collectionId",
          "type",
          "originalUrl",
          "metadata",
          "createdAt"
        ]
      },
      "MediaCollection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "postId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174002"
          },
          "createdAt": { "format": "date-time", "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MediaItem" }
          }
        },
        "required": ["id", "postId", "createdAt", "items"]
      },
      "CreateAwardDto": {
        "type": "object",
        "properties": {
          "targetType": {
            "type": "string",
            "description": "The type of the target being awarded",
            "enum": ["POST", "COMMENT"],
            "example": "POST"
          },
          "targetId": {
            "type": "string",
            "description": "The UUID of the target being awarded",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "description": "Name of the award",
            "example": "Gold"
          }
        },
        "required": ["targetType", "targetId", "name"]
      },
      "Award": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Award UUID" },
          "awardedById": {
            "type": "string",
            "description": "User UUID who gave the award"
          },
          "targetType": {
            "type": "string",
            "description": "Target type",
            "enum": ["POST", "COMMENT"]
          },
          "targetId": { "type": "string", "description": "Target UUID" },
          "name": { "type": "string", "description": "Name of the award" },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Creation timestamp"
          }
        },
        "required": [
          "id",
          "awardedById",
          "targetType",
          "targetId",
          "name",
          "createdAt"
        ]
      },
      "FeedUser": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "displayName": { "type": "object", "nullable": true }
        },
        "required": ["id", "username", "displayName"]
      },
      "FeedSoma": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["id", "slug", "name"]
      },
      "FeedMediaItem": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "originalUrl": { "type": "string" }
        },
        "required": ["type", "originalUrl"]
      },
      "FeedMediaCollection": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FeedMediaItem" }
          }
        },
        "required": ["items"]
      },
      "FeedItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "object", "nullable": true },
          "createdAt": { "format": "date-time", "type": "string" },
          "author": { "$ref": "#/components/schemas/FeedUser" },
          "soma": { "$ref": "#/components/schemas/FeedSoma" },
          "media": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/FeedMediaCollection" }]
          },
          "voteCount": { "type": "number" },
          "awardCount": { "type": "number" }
        },
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "author",
          "soma",
          "media",
          "voteCount",
          "awardCount"
        ]
      }
    }
  }
}
